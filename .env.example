# Variables de entorno del vehicle-telemetry-service.
# Este archivo es solo documentacion: no pongas valores reales aqui.
# Configura los valores reales en tu IDE o en un .env local (ignorado por Git).

DB_URL=jdbc:postgresql://localhost:5432/automind
DB_USERNAME=automind
DB_PASSWORD=change-me

# Usuario de la API para desarrollo (perfil dev). Temporal hasta definir la autenticacion real.
DEV_API_USERNAME=dev
DEV_API_PASSWORD=change-me
